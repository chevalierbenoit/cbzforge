{% extends 'base.html.twig' %}

{% block title %}{{ 'login.title'|trans }} — cbzforge{% endblock %}

{% block body %}
<div class="auth-page">
    <div class="auth-stack">
        {{ include('security/_brand.html.twig') }}
        <form method="post" action="{{ path('app_login') }}" class="card auth-card">
            <div class="card-header">
                <h1 class="card-title">{{ 'login.title'|trans }}</h1>
            </div>
            <div class="card-body">
                {% if error %}
                    <div class="flash flash-error" role="alert">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
                {% endif %}
                <div class="form-group">
                    <label for="username">{{ 'login.username'|trans }}</label>
                    <input type="text" id="username" name="_username" value="{{ last_username }}" autocomplete="username" required autofocus>
                </div>
                <div class="form-group">
                    <label for="password">{{ 'login.password'|trans }}</label>
                    <input type="password" id="password" name="_password" autocomplete="current-password" required>
                </div>
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
            </div>
            <div class="card-footer">
                <button type="submit" class="btn btn-primary">{{ 'login.submit'|trans }}</button>
            </div>
        </form>
    </div>
</div>
{% endblock %}
