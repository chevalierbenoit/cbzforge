{% extends 'base.html.twig' %}
{% import 'components/_icons.html.twig' as ui %}

{% block title %}{{ 'sidebar.libraries'|trans }} — cbzforge{% endblock %}

{% block body %}
<div class="page">
    <div class="page-header">
        <div>
            <h1>{{ 'dashboard.my_libraries'|trans }}</h1>
        </div>
        {% if libraries is not empty %}
            <div class="page-actions">
                <a href="{{ path('admin_libraries') }}" class="btn">{{ ui.icon('settings') }}{{ 'dashboard.manage'|trans }}</a>
            </div>
        {% endif %}
    </div>

    {% if libraries is empty %}
        <div class="card">
            <div class="empty-state">
                {{ ui.icon('library') }}
                <h2>{{ 'dashboard.no_libraries'|trans }}</h2>
                <p>{{ 'dashboard.empty_hint'|trans }}</p>
                <a href="{{ path('admin_libraries') }}" class="btn btn-primary">{{ ui.icon('plus') }}{{ 'dashboard.configure_library'|trans }}</a>
            </div>
        </div>
    {% else %}
        <div class="library-grid">
            {% for library in libraries %}
            <article class="library-card">
                <div class="library-card-head">
                    <span class="library-card-icon">{{ ui.icon('library') }}</span>
                    <div class="library-card-info">
                        <div class="library-card-name">{{ library.name }}</div>
                        <div class="library-card-path" title="{{ library.path }}">{{ library.path }}</div>
                    </div>
                </div>
                <a href="{{ path('library_explore', {id: library.id}) }}" class="btn btn-primary">{{ ui.icon('folder') }}{{ 'dashboard.browse'|trans }}</a>
            </article>
            {% endfor %}
        </div>
    {% endif %}
</div>
{% endblock %}
