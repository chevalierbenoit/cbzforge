{% extends 'base.html.twig' %}
{% import 'components/_icons.html.twig' as ui %}

{% block title %}{{ 'admin.settings.scrapers'|trans }} — cbzforge{% endblock %}

{% block body %}
<div class="page">
    <div class="page-header">
        <div>
            <h1>{{ 'admin.settings.scrapers'|trans }}</h1>
            <p class="page-lead">{{ 'admin.settings.lead'|trans }}</p>
        </div>
    </div>

    <form method="post" action="{{ path('admin_settings') }}" class="stack">
    {% for scraper in scrapers %}
        {% set scraper_slug = scraper.name|replace({' ': '_'}) %}
        <section class="card">
            <div class="card-header">
                <h2 class="card-title">{{ scraper.name }}</h2>
                {% if not scraper.enabled %}
                    <span class="badge badge-neutral">{{ 'admin.settings.inactive'|trans }}</span>
                {% elseif not scraper.configured %}
                    <span class="badge badge-warning">{{ ui.icon('alert') }}{{ 'admin.settings.not_configured'|trans }}</span>
                {% else %}
                    <span class="badge badge-success">{{ ui.icon('check') }}{{ 'admin.settings.available'|trans }}</span>
                {% endif %}
            </div>
            <div class="card-body">
                <input type="hidden" name="scraper_enabled_{{ scraper_slug }}" value="0">
                <label class="form-checkbox">
                    <input type="checkbox" name="scraper_enabled_{{ scraper_slug }}" id="toggle-{{ scraper_slug }}" value="1"
                           {% if scraper.enabled and scraper.configured %}checked{% endif %}
                           {% if not scraper.configured %}disabled{% endif %}>
                    {{ 'admin.settings.enable'|trans }}
                </label>
                {% if not scraper.configured %}
                    <p class="form-help">{{ 'admin.settings.not_configured_help'|trans }}</p>
                {% endif %}

                {% if scraper.fields is empty %}
                    <p class="form-help">{{ 'admin.settings.no_config'|trans }}</p>
                {% else %}
                    <div class="form-grid" style="margin-top: 1rem;">
                    {% for field in scraper.fields %}
                        <div class="form-group">
                            <label for="settings-{{ field.key }}">{{ field.label }}{% if field.required %} <span class="card-muted">*</span>{% endif %}</label>
                            <input type="{{ field.type }}" id="settings-{{ field.key }}"
                                   name="{{ field.key }}" value="{{ field.value }}" autocomplete="off"
                                   {% if field.value %}placeholder="••••••••"{% endif %}>
                        </div>
                    {% endfor %}
                    </div>
                {% endif %}
            </div>
        </section>
    {% endfor %}
        <div class="form-actions">
            <button type="submit" class="btn btn-primary">{{ 'admin.save'|trans }}</button>
        </div>
    </form>
</div>
{% endblock %}
