{% extends 'base.html.twig' %}

{% block title %}{{ 'admin.edit_library_title'|trans }} — cbzforge{% endblock %}

{% block body %}
<div class="page">
    <div class="page-header">
        <div>
            <h1>{{ 'admin.edit_library_title'|trans }}</h1>
            <p class="page-lead">{{ library.name }}</p>
        </div>
    </div>

    <form method="POST" class="card">
        <div class="card-body">
            <div class="form-grid">
                <div class="form-group">
                    <label for="name">{{ 'admin.edit_library.name'|trans }}</label>
                    <input type="text" id="name" name="name" value="{{ library.name }}" required>
                </div>
                <div class="form-group">
                    <label for="path">{{ 'admin.edit_library.path'|trans }}</label>
                    <input type="text" id="path" name="path" value="{{ library.path }}" required>
                </div>
            </div>
        </div>
        <div class="card-footer">
            <a href="{{ path('admin_libraries') }}" class="btn">{{ 'admin.cancel'|trans }}</a>
            <button type="submit" class="btn btn-primary">{{ 'admin.save'|trans }}</button>
        </div>
    </form>
</div>
{% endblock %}
