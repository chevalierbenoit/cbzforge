{% extends 'base.html.twig' %}
{% import 'components/_icons.html.twig' as ui %}

{% block title %}{{ 'admin.tasks.title'|trans }} — cbzforge{% endblock %}

{% block body %}
<div class="page" data-controller="tasks-admin" data-tasks-admin-locale-value="{{ app.request.locale }}">
    <div class="page-header">
        <div>
            <h1>{{ 'admin.tasks.title'|trans }}</h1>
            <p class="page-lead">{{ 'admin.tasks.lead'|trans }}</p>
        </div>
        <div class="page-actions">
            <span class="badge badge-neutral" data-tasks-admin-target="workerBadge">
                <span data-tasks-admin-target="workerLabel">{{ 'admin.tasks.worker'|trans }}</span>
            </span>
            <button type="button" class="btn" data-action="tasks-admin#restartWorker">{{ ui.icon('refresh') }}{{ 'admin.tasks.restart_worker'|trans }}</button>
            <button type="button" class="btn" data-action="tasks-admin#purgeTasks">{{ ui.icon('trash') }}{{ 'admin.tasks.purge_completed_failed'|trans }}</button>
        </div>
    </div>

    <section class="card">
        {% if tasks is not empty %}
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>{{ 'admin.tasks.type'|trans }}</th>
                        <th>{{ 'admin.tasks.file'|trans }}</th>
                        <th>{{ 'admin.tasks.status'|trans }}</th>
                        <th>{{ 'admin.tasks.error'|trans }}</th>
                        <th>{{ 'admin.tasks.created_at'|trans }}</th>
                        <th><span class="sr-only">{{ 'admin.tasks.actions'|trans }}</span></th>
                    </tr>
                </thead>
                <tbody>
                {% for task in tasks %}
                    <tr>
                        <td>{{ task.type }}</td>
                        <td><code>{{ task.path }}</code></td>
                        <td>
                            {% if task.status == 'pending' %}
                                <span class="badge badge-neutral">{{ 'tasks.status.pending'|trans }}</span>
                            {% elseif task.status == 'processing' %}
                                <span class="badge badge-warning">{{ 'tasks.status.processing'|trans }}</span>
                            {% elseif task.status == 'completed' %}
                                <span class="badge badge-success">{{ ui.icon('check') }}{{ 'tasks.status.completed'|trans }}</span>
                            {% elseif task.status == 'failed' %}
                                <span class="badge badge-danger">{{ ui.icon('alert') }}{{ 'tasks.status.failed'|trans }}</span>
                            {% endif %}
                        </td>
                        <td>{% if task.error %}<code>{{ task.error }}</code>{% endif %}</td>
                        <td class="card-muted">{{ task.createdAt|date('d/m/Y H:i') }}</td>
                        <td class="table-actions">
                            {% if task.status in ['failed', 'processing'] %}
                            <button type="button" class="btn btn-sm btn-icon" data-id="{{ task.id }}" data-action="tasks-admin#retryTask"
                                    aria-label="{{ 'admin.tasks.retry'|trans }}" title="{{ 'admin.tasks.retry'|trans }}">{{ ui.icon('refresh') }}</button>
                            {% endif %}
                            <button type="button" class="btn btn-sm btn-icon btn-danger" data-id="{{ task.id }}" data-action="tasks-admin#deleteTask"
                                    aria-label="{{ 'admin.tasks.delete'|trans }}" title="{{ 'admin.tasks.delete'|trans }}">{{ ui.icon('trash') }}</button>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
        {% else %}
        <div class="empty-state">
            {{ ui.icon('queue') }}
            <p>{{ 'admin.tasks.none'|trans }}</p>
        </div>
        {% endif %}
    </section>
</div>
{% endblock %}
