{% extends 'base.html.twig' %}

{% block title %}{{ 'admin.rename.expression'|trans }} — cbzforge{% endblock %}

{% block body %}
<div class="page">
    <div class="page-header">
        <div>
            <h1>{{ 'admin.rename.expression'|trans }}</h1>
            <p class="page-lead">{{ 'admin.rename.lead'|trans }}</p>
        </div>
    </div>

    <div data-turbo-cache="false" data-controller="rename-preview">
    <form method="post" action="{{ path('admin_rename_settings') }}" data-turbo="false" class="stack">
        <input type="hidden" name="_token" value="{{ csrf_token('submit') }}">
        <section class="card">
            <div class="card-body">
                <div class="form-group">
                    <label for="rename-expression">{{ 'admin.rename.expression_label'|trans }}</label>
                    <input type="text" id="rename-expression" name="expression"
                           value="{{ expression }}" class="mono"
                           data-rename-preview-target="input"
                           data-action="input->rename-preview#preview"
                           placeholder="{serie}/{numero} - {titre}">
                </div>

                <div class="form-group">
                    <span class="form-label">{{ 'admin.rename.preview_label'|trans }}</span>
                    <div id="rename-preview" class="mono" data-rename-preview-target="output" role="status">{{ preview }}</div>
                </div>
            </div>
        </section>

        <section class="card">
            <div class="card-header">
                <h2 class="card-title">{{ 'admin.rename.available_aliases'|trans }}</h2>
            </div>
            <div class="table-wrap" style="max-height: 360px; overflow-y: auto;">
                <table>
                    <thead>
                        <tr>
                            <th>{{ 'admin.rename.alias'|trans }}</th>
                            <th>{{ 'admin.rename.field'|trans }}</th>
                            <th>{{ 'admin.rename.description'|trans }}</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for alias in aliases %}
                        <tr>
                            <td><code>{{ alias.alias }}</code></td>
                            <td class="card-muted">{{ alias.field }}</td>
                            <td>{{ alias.description }}</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </section>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">{{ 'admin.save'|trans }}</button>
        </div>
    </form>
    </div>
</div>
{% endblock %}
