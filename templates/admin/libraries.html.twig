{% extends 'base.html.twig' %}

{% block title %}{{ 'admin.libraries.manage'|trans }} — ComicsScraper{% endblock %}

{% block sidebar %}
    {{ include('admin/_sidebar.html.twig') }}
{% endblock %}

{% block body %}
<div class="page-wrapper">
    <div class="page-header">
        <h1>{{ 'admin.libraries.manage'|trans }}</h1>
    </div>

    <div class="settings-card">
        <h3>{{ 'admin.add_library'|trans }}</h3>
        <form method="POST" action="{{ path('admin_libraries_add') }}" class="settings-form-row">
            <input type="text" name="name" placeholder="{{ 'admin.name_placeholder'|trans }}" required style="flex: 1;">
            <input type="text" name="path" placeholder="{{ 'admin.path_placeholder'|trans }}" required style="flex: 2;">
            <button type="submit" class="btn btn-primary">{{ 'admin.add'|trans }}</button>
        </form>
    </div>

    <h3>{{ 'sidebar.libraries'|trans }}</h3>
    <div class="settings-card" style="padding: 0;">
        {% for library in libraries %}
        <div class="admin-list-row">
            <div class="admin-list-info">
                <div class="admin-list-name">{{ library.name }}</div>
                <div class="admin-list-path"><code>{{ library.path }}</code></div>
            </div>
            <div class="admin-list-actions">
                <a href="{{ path('library_explore', {id: library.id}) }}" class="btn btn-secondary btn-sm">{{ 'admin.browse'|trans }}</a>
                <a href="{{ path('admin_libraries_edit', {id: library.id}) }}" class="btn btn-secondary btn-sm">{{ 'admin.edit'|trans }}</a>
                <form method="POST" action="{{ path('admin_libraries_delete', {id: library.id}) }}" style="display: inline;"
                      data-turbo="false"
                      onsubmit="return confirm('{{ 'admin.confirm_delete'|trans }}')">
                    <button type="submit" class="btn btn-danger btn-sm">{{ 'admin.delete'|trans }}</button>
                </form>
            </div>
        </div>
        {% else %}
        <div style="padding: 2rem; text-align: center; color: var(--text-subtle); font-size: 0.85rem;">
            {{ 'admin.no_libraries'|trans }}
        </div>
        {% endfor %}
    </div>
</div>
{% endblock %}
