{% extends 'base.html.twig' %}

{% block title %}{{ 'admin.conversion'|trans }} — cbzforge{% endblock %}

{% block body %}
<div class="page">
    <div class="page-header">
        <div>
            <h1>{{ 'admin.conversion.title'|trans }}</h1>
            <p class="page-lead">{{ 'admin.conversion.lead'|trans }}</p>
        </div>
    </div>

    <form method="post" action="{{ path('admin_conversion_settings') }}" class="card">
        <div class="card-header">
            <h2 class="card-title">{{ 'admin.conversion.pdf_quality'|trans }}</h2>
        </div>
        <div class="card-body">
            <div class="form-grid">
                <div class="form-group">
                    <label for="pdf_format">{{ 'admin.conversion.image_format'|trans }}</label>
                    <select id="pdf_format" name="pdf_format">
                        <option value="jpeg"{% if pdf_format == 'jpeg' %} selected{% endif %}>JPEG</option>
                        <option value="png"{% if pdf_format == 'png' %} selected{% endif %}>PNG</option>
                    </select>
                    <span class="form-help">{{ 'admin.conversion.format_help'|trans }}</span>
                </div>
                <div class="form-group">
                    <label for="pdf_dpi">{{ 'admin.conversion.dpi'|trans }}</label>
                    <select id="pdf_dpi" name="pdf_dpi">
                        <option value="150"{% if pdf_dpi == '150' %} selected{% endif %}>150 DPI</option>
                        <option value="300"{% if pdf_dpi == '300' %} selected{% endif %}>300 DPI</option>
                    </select>
                    <span class="form-help">{{ 'admin.conversion.dpi_help'|trans }}</span>
                </div>
            </div>
        </div>
        <div class="card-footer">
            <button type="submit" class="btn btn-primary">{{ 'admin.save'|trans }}</button>
        </div>
    </form>
</div>
{% endblock %}
