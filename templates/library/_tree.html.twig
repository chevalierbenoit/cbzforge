{#
    Folder tree of a library. Only the folders on the current path are expanded;
    their siblings stay visible so the user can jump to any neighbour.
#}
{% macro nodes(nodes, library) %}
{% import 'components/_icons.html.twig' as ui %}
<ul class="tree">
{% for node in nodes %}
    <li>
        <a href="{{ path('library_explore', {id: library.id, path: node.path}) }}"
           class="tree-link{{ node.active ? ' is-active' : '' }}"{{ node.active ? ' aria-current="page"' : '' }}>
            {{ ui.icon(node.expanded ? 'folder_open' : 'folder') }}<span>{{ node.name }}</span>
        </a>
        {% if node.children is not empty %}
            {{ _self.nodes(node.children, library) }}
        {% endif %}
    </li>
{% endfor %}
</ul>
{% endmacro %}
