{% extends 'base.html.twig' %}
{% import 'components/_icons.html.twig' as ui %}

{% block title %}{{ library.name }} — cbzforge{% endblock %}

{% block body %}
{% set dirs = entries|filter(e => e.type == 'dir') %}
{% set files = entries|filter(e => e.type == 'file') %}
<div class="library-page-wrapper"
     data-controller="scrape rename"
     data-scrape-library-id-value="{{ library.id }}"
     data-scrape-scrapers-value='{{ scrapers|json_encode }}'
     data-scrape-locale-value="{{ app.request.locale }}"
     data-rename-library-id-value="{{ library.id }}"
     data-rename-locale-value="{{ app.request.locale }}">

    <header class="explorer-toolbar">
        <div class="explorer-title">
            <nav class="breadcrumb" aria-label="{{ 'explore.location'|trans }}">
                <a href="{{ path('library_explore', {id: library.id}) }}" class="breadcrumb-item">{{ library.name }}</a>
                {% if currentPath is not empty %}
                    {% set segments = currentPath|split('/') %}
                    {% set cumul = '' %}
                    {% for segment in segments %}
                        {% set cumul = cumul ~ (loop.first ? '' : '/') ~ segment %}
                        <span class="breadcrumb-sep" aria-hidden="true">/</span>
                        {% if loop.last %}
                            <span class="breadcrumb-current" aria-current="page">{{ segment }}</span>
                        {% else %}
                            <a href="{{ path('library_explore', {id: library.id, path: cumul}) }}" class="breadcrumb-item">{{ segment }}</a>
                        {% endif %}
                    {% endfor %}
                {% endif %}
            </nav>
            <span class="explorer-count">{{ files|length }} {{ 'explore.file'|trans({count: files|length}) }}{% if dirs is not empty %}, {{ dirs|length }} {{ 'explore.folder'|trans({count: dirs|length}) }}{% endif %}</span>
        </div>

        <div class="metadata-actions" role="toolbar" aria-label="{{ 'explore.actions'|trans }}">
            <span class="selection-counter" id="selection-counter" aria-live="polite"></span>
            <button class="btn btn-sm metadata-action-btn"
                    data-action="scrape#searchFiles"
                    title="{{ 'explore.search_hint'|trans }}"
                    disabled>{{ ui.icon('search') }}{{ 'explore.search'|trans }}</button>
            {% if 'BDGest' in scrapers %}
            <button id="url-scrape-btn" class="btn btn-sm metadata-action-btn"
                    data-action="scrape#urlScrape"
                    disabled style="display: none;">BDGest</button>
            {% endif %}
            <button id="rename-btn" class="btn btn-sm metadata-action-btn"
                    data-action="rename#smartPreview"
                    title="{{ 'explore.rename_hint'|trans }}"
                    disabled>{{ 'explore.rename'|trans }}</button>
            <button id="convert-btn" class="btn btn-sm metadata-action-btn"
                    data-action="rename#convert"
                    disabled style="display: none;">{{ 'explore.convert_to_cbz'|trans }}</button>
        </div>
    </header>

    <div class="library-layout">
        {% import 'library/_tree.html.twig' as tree %}
        <aside class="explorer-tree" aria-label="{{ 'explore.folders'|trans }}">
            <div class="explorer-tree-title">{{ 'explore.folders'|trans }}</div>
            <ul class="tree">
                <li>
                    <a href="{{ path('library_explore', {id: library.id}) }}"
                       class="tree-link{{ currentPath == '' ? ' is-active' : '' }}"{{ currentPath == '' ? ' aria-current="page"' : '' }}>
                        {{ ui.icon('library') }}<span>{{ library.name }}</span>
                    </a>
                    {{ tree.nodes(folderTree, library) }}
                </li>
            </ul>
        </aside>

        <div class="browser-column" data-controller="inline-rename" data-inline-rename-library-id-value="{{ library.id }}">
            {% if files is not empty or dirs is not empty %}
            <div class="file-grid">
                {% for entry in dirs %}
                <a class="folder-card" href="{{ path('library_explore', {id: library.id, path: entry.path}) }}">
                    <div class="folder-card-icon">{{ ui.icon('folder') }}</div>
                    <div class="file-card-body">
                        <div class="file-card-name">{{ entry.name }}</div>
                    </div>
                </a>
                {% endfor %}
                {% for entry in files %}
                <div class="file-card{{ entry.extension != 'cbz' and entry.extension != '' ? ' file-card-unreadable' : '' }}"
                     data-path="{{ entry.path|e('html_attr') }}"
                     data-action="click->scrape#showMetadata"
                     data-scrape-path-param="{{ entry.path|e('html_attr') }}">
                    <div class="file-card-cover">
                        {% if entry.extension == 'cbz' %}
                            <img src="{{ path('file_cover', {path: entry.path, library_id: library.id}) }}" alt=""
                                 loading="lazy"
                                 onerror="this.style.display='none';this.parentElement.querySelector('.file-icon').style.display='flex'">
                            <div class="file-icon" style="display:none;">{{ ui.icon('image') }}</div>
                        {% else %}
                            <div class="file-icon">{{ ui.icon('file') }}</div>
                        {% endif %}
                    </div>
                    <div class="file-card-body">
                        <div class="file-card-name" title="{{ entry.name }}">{{ entry.name }}</div>
                        {% if entry.extension == 'cbz' %}
                            {% if entry.has_metadata %}
                                <span class="badge badge-success">{{ 'explore.has_metadata'|trans }}</span>
                            {% else %}
                                <span class="badge badge-neutral">{{ 'explore.no_metadata'|trans }}</span>
                            {% endif %}
                        {% elseif entry.extension != '' %}
                            <span class="badge badge-warning" title="{{ 'explore.needs_conversion_hint'|trans }}">{{ 'explore.needs_conversion'|trans({'%ext%': entry.extension|upper}) }}</span>
                        {% endif %}
                    </div>
                </div>
                {% endfor %}
            </div>
            {% else %}
                <div class="empty-state">
                    {{ ui.icon('folder') }}
                    <p>{{ 'explore.no_files'|trans }}</p>
                </div>
            {% endif %}
        </div>

        <aside id="metadata-display" class="metadata-panel" aria-label="{{ 'explore.metadata'|trans }}">
            <button type="button" id="metadata-close" class="metadata-close-btn"
                    data-action="scrape#closeMetadata"
                    aria-label="{{ 'explore.close'|trans }}" title="{{ 'explore.close'|trans }}">&times;</button>
            <div id="metadata-content">
                <p class="form-help">{{ 'explore.select_file'|trans }}</p>
            </div>
        </aside>
    </div>

    <div data-controller="modal" class="modal-overlay" data-action="click->modal#closeBackdrop">
        <div class="modal-dialog" data-modal-target="content"></div>
    </div>
</div>
{% endblock %}
